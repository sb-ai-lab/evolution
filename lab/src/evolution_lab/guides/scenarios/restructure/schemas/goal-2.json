{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restructure-goal/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "prompt", "skills", "tools", "texts", "handler", "deps", "modes", "changes",
               "questions"],
  "x-template": {
    "name": "sylph",
    "how": {
      "text": "Каждый ход проходит одну дорожку: обработчик до модели, агент (системный промпт, выбранный скилл и инструменты), обработчик после модели. Артефакты — промпт, скиллы, готовые тексты — потом улучшает evolve; код — только вручную.",
      "flow": [{"id": "message", "label": "Сообщение", "kind": "message"},
               {"id": "before", "label": "Обработчик · до", "kind": "handler"},
               {"id": "agent", "label": "Агент: промпт + скилл + tools", "kind": "agent"},
               {"id": "after", "label": "Обработчик · после", "kind": "handler"},
               {"id": "answer", "label": "Ответ", "kind": "answer"}],
      "kinds": [{"id": "evolve", "title": "Артефакты · улучшает evolve",
                 "text": "Системный промпт, скиллы, готовые тексты — файлы, которые меняет evolve."},
                {"id": "code", "title": "Код · только вручную",
                 "text": "Инструменты, обработчик хода, зависимости — правит человек или builder."}]},
    "cells": {"prompt": "evolve", "skills": "evolve", "texts": "evolve", "tools": "code", "handler": "code",
              "deps": "code", "modes": null, "changes": null, "questions": null}
  },
  "properties": {
    "schema": {"const": "restructure-goal/2"},
    "source": {"$ref": "#/$defs/text"},
    "prompt": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "text", "origin"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"},
                     "origin": {"$ref": "#/$defs/text"}}}},
    "skills": {
      "type": "object", "additionalProperties": false, "required": ["links", "knowledge_links"],
      "properties": {"links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
                     "knowledge_links": {"type": "array", "items": {"$ref": "#/$defs/link"}}}
    },
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["links"],
      "properties": {"links": {"type": "array", "items": {"$ref": "#/$defs/link"}}}
    },
    "texts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "when", "file", "text"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "when": {"$ref": "#/$defs/text"}, "file": {"$ref": "#/$defs/text"},
                     "text": {"$ref": "#/$defs/text"}}}},
    "handler": {
      "type": "object", "additionalProperties": false, "required": ["before", "after", "codes"],
      "properties": {
        "before": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "after": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "codes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "note"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/text"}, "to": {"$ref": "#/$defs/text"},
                         "note": {"type": ["string", "null"]}}}}
      }
    },
    "deps": {
      "type": "object", "additionalProperties": false, "required": ["session", "clients", "state"],
      "properties": {
        "session": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "clients": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "offline", "sandbox"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"},
                         "offline": {"$ref": "#/$defs/text"}, "sandbox": {"type": ["string", "null"]}}}},
        "state": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      }
    },
    "modes": {
      "type": "object", "additionalProperties": false, "required": ["modes", "ladder"],
      "properties": {
        "modes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "included", "note"],
          "properties": {"id": {"enum": ["offline", "live"]}, "included": {"type": "boolean"},
                         "note": {"type": ["string", "null"]}}}},
        "ladder": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "text", "layer", "threshold"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"},
                         "layer": {"type": ["string", "null"]},
                         "threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}}
      }
    },
    "changes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "why"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}}}},
    "questions": {"$ref": "#/$defs/questions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1,
                "items": {"type": "string", "pattern": "^(?!/)(?!#)(?!(?:[^#]*/)?\\.\\.(?:[/#]|$))[^#\\n]+(?:#.+)?(?![\\s\\S])"}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
    "item": {"type": "object", "additionalProperties": false, "required": ["id", "text"],
             "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}}},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "options", "recommended", "answer"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}, "why": {"type": ["string", "null"]},
        "options": {"type": "array", "maxItems": 6, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "text"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"},
                         "consequence": {"type": ["string", "null"]}}}},
        "recommended": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "answer": {"oneOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["option", "for"],
           "properties": {"option": {"$ref": "#/$defs/id"}, "for": {"$ref": "#/$defs/digest"}}},
          {"type": "object", "additionalProperties": false, "required": ["text", "for"],
           "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 2000},
                          "for": {"$ref": "#/$defs/digest"}}}]}
      }
    },
    "questions": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/question"}},
    "link": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "method", "to", "note"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "label"],
          "properties": {"kind": {"enum": ["topic", "prompt", "skill", "knowledge", "call", "system_step"]},
                         "label": {"$ref": "#/$defs/text"}, "ref": {"$ref": "#/$defs/id"}}}},
        "method": {"enum": ["as_skill", "merge", "split", "to_handler", "to_prompt", "as_is", "as_tool", "keep_code",
                            "drop"]},
        "to": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "label"],
          "properties": {"kind": {"enum": ["skill", "system_prompt", "handler", "dependency", "tool", "prompt_text"]},
                         "label": {"$ref": "#/$defs/text"}}}},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
