{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "implementation",
    "skill",
    "scenarios",
    "tools",
    "constraints",
    "check_plan"
  ],
  "properties": {
    "schema": {
      "const": "create-skill-brief/1"
    },
    "implementation": {
      "$ref": "#/$defs/id"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "summary"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "summary": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "check_plan": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?!\\.$)(?!(?:.*/)?\\.\\.(?:/|$)).+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
