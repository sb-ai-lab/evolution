# Local paper experiment paths. Copy to .env for local runs.
SKILL_EVOLUTIONS_ROOT=/path/to/skill_evolutions
AFTER_DATA_ROOT=/path/to/skill_evolutions/datasets/sb-bench
HERMES_REPO=/path/to/skill_evolutions/hermes-agent
MEMENTO_REPO=/path/to/skill_evolutions/Memento-Skills
MEMP_REPO=/path/to/skill_evolutions/MemP

# Codex / Claude Code integration (needed for REFLECTOR=codex launches).
EVO_BASHRC_PATH=/path/to/your/.bashrc

# Python interpreter for experiment scripts (defaults to python3).
EVO_PYTHON=/path/to/envs/<your-env>/bin/python

# Path to file containing the OpenRouter API key (optional convenience).
OPENROUTER_KEY_PATH=/path/to/.config/openrouter_key

# Role-specific Python interpreters (defaults computed from $HOME/.mlspace/envs/).
# Override only if your conda layout differs.
# EVO_ROLE_PYTHON_DE=/path/to/envs/de-env/bin/python
# EVO_ROLE_PYTHON_DS=/path/to/envs/ds-env/bin/python
# EVO_ROLE_PYTHON_INFRA=/path/to/envs/infra-env/bin/python

# Local OpenAI-compatible model endpoints (Table 3/4 experiments).
LOCAL_QWEN_API_BASE=http://localhost:30004/v1
LOCAL_QWEN_API_KEY=EMPTY
LOCAL_QWEN_GATE_PERMITS=3
LOCAL_GPT_OSS_120B_API_BASE=http://localhost:30004/v1
LOCAL_GPT_OSS_120B_API_KEY=EMPTY
LOCAL_GEMMA_API_BASE=http://localhost:30005/v1
LOCAL_LLAMA_API_BASE=http://localhost:30006/v1
LOCAL_GPT_OSS_20B_API_BASE=http://localhost:30008/v1

# Provider secrets — leave blank here, set real values in .env (gitignored).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
