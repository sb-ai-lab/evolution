# ============================================================================
# Python Research Project
# ============================================================================
docs/
splits/
CLAUDE.md

results/*
plans/
tasks/
!AFTER-anonymous/tasks/
!AFTER-anonymous/tasks/**
.github/
uv.lock

# splits/: track only Python scripts; ignore manifests/data
splits/**/manifests/
splits/**/*.json
splits/**/*.md
splits/**/*.yaml
!splits/**/*.py
experiments/*
!experiments/_shared/
!experiments/baselines/
!experiments/iterative_evolution/
!experiments/AGENTS.md

# Inside each shared/kept dir: ignore all direct children by default.
experiments/_shared/*
experiments/baselines/*
experiments/iterative_evolution/*

# baselines / iterative_evolution: track only root entrypoint scripts (+ ie tests).
!experiments/baselines/*.py
!experiments/baselines/*.sh
!experiments/baselines/subset.json
!experiments/iterative_evolution/*.py
!experiments/iterative_evolution/*.sh
!experiments/iterative_evolution/tests/
!experiments/iterative_evolution/tests/**

# _shared: keep the full source tree.
!experiments/_shared/**

# Ignore heavy runtime outputs inside any tracked experiment dir.
experiments/**/artifacts/
experiments/**/artifacts_*/
experiments/**/eval_runs/
experiments/**/runs/
experiments/**/results/
experiments/**/stability/
experiments/**/__pycache__/
experiments/**/*.pyc
experiments/**/*.log
experiments/**/embedding_cache/
experiments/**/tasks_flat/
experiments/**/.evolution/
*tar.gz
